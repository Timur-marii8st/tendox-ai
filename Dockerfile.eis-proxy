FROM alpine:3.22
RUN apk add --no-cache openssh-client
CMD ["ssh", "-N", "-D", "0.0.0.0:1080", "-i", "/run/eis-proxy/id_ed25519", "-o", "UserKnownHostsFile=/run/eis-proxy/known_hosts", "-o", "StrictHostKeyChecking=yes", "-o", "BatchMode=yes", "-o", "ExitOnForwardFailure=yes", "-o", "ServerAliveInterval=20", "-o", "ServerAliveCountMax=3", "-o", "ConnectTimeout=10", "timur-marii8st@88.218.66.108"]
