{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "build/comparison-tests",
    "noEmitOnError": true
  },
  "include": [
    "tests/procurement-comparison.test.tsx",
    "tests/fixtures/procurement-comparison.json",
    "src/lib/procurement-comparison.ts",
    "src/app/procurement-comparison/report.tsx",
    "tests/notice-profile-comparison.test.tsx",
    "src/lib/notice-profile-comparison.ts",
    "src/app/tender-discovery/profile-comparison-report.tsx"
  ]
}
