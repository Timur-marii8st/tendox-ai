{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "build/joint-position-tests",
    "noEmitOnError": true
  },
  "include": [
    "tests/position-evidence-223.test.tsx",
    "src/app/tender-discovery/position-evidence-223.tsx",
    "tests/gosplan-detail.test.tsx",
    "tests/gosplan-pagination.test.tsx",
    "src/app/tender-discovery/gosplan-pagination.tsx",
    "src/app/tender-discovery/gosplan-detail.tsx"
  ]
}
