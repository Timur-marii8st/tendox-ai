# Только локальная разработка. Создайте .env и замените значения.
POSTGRES_DB=procurement
POSTGRES_USER=procurement_owner
POSTGRES_PASSWORD=replace-with-local-owner-password
APP_DB_PASSWORD=replace-with-different-local-runtime-password
POSTGRES_PORT=5432

DATABASE_ADMIN_URL=postgresql+psycopg://procurement_owner:replace-with-local-owner-password@127.0.0.1:5432/procurement
DATABASE_URL=postgresql+psycopg://procurement_app:replace-with-different-local-runtime-password@127.0.0.1:5432/procurement
